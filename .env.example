BRIDE_RSVP_ENDPOINT=https://script.google.com/macros/s/AKfycbxy8jCXgau5B20Okh6bgH9ZVZTqj8MwxmrBXzHnNMrP2mHPIImzG5Rr8wbfOzsXIC8/exec
